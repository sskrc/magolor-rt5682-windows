[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Mfg%
CatalogFile=jslcodec.cat
DriverVer=10/12/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
jslcodec.sys=1

[Manufacturer]
%Mfg%=Models,NTamd64

[Models.NTamd64]
%Dev%=Install,ACPI\10EC5682

[Install.NT]
CopyFiles=Files

[Files]
jslcodec.sys

[Install.NT.Services]
AddService=jslcodec,0x2,Svc

[Svc]
DisplayName=%Dev%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\jslcodec.sys

[Install.NT.Wdf]
KmdfService=jslcodec,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Mfg="Personal"
Disk="JSL RT5682 codec"
Dev="JSL RT5682 Headset Codec"
